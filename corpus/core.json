":"word","source":"core"},{"term":"噶","meaning":"方言语气词（「是吧」），也谐音「挂」表示死了","register":"net","field":"方言","kind":"word","source":"core"},{"term":"犊子","meaning":"东北方言，小子/家伙，多见于「滚犊子」","register":"net","field":"方言","kind":"word","source":"core"},{"term":"吹牛","meaning":"说大话、夸张炫耀","register":"net","field":"方言","aliases":["吹牛逼"],"kind":"word","source":"core"},{"term":"扯淡","meaning":"胡说、瞎扯","register":"net","field":"方言","aliases":["扯犊子"],"kind":"word","source":"core"},{"term":"画大饼","meaning":"用空头承诺哄人（多见于老板许诺）","register":"net","field":"职场","aliases":["画饼"],"kind":"word","source":"core"},{"term":"背锅","meaning":"替别人的过错承担责任","register":"net","field":"职场","aliases":["背黑锅"],"kind":"word","source":"core"},{"term":"甩锅","meaning":"把责任推给别人","register":"net","field":"职场","kind":"word","source":"core"},{"term":"向上管理","meaning":"有意识地经营与上级的关系、影响其决策","register":"net","field":"职场","kind":"word","source":"core"},{"term":"优化","meaning":"委婉说法：裁员、把人清出去","register":"pro","field":"职场暗语","aliases":["结构性优化"],"kind":"word","source":"core"},{"term":"毕业","meaning":"委婉说法：被裁员、被清退（「从公司毕业」）","register":"pro","field":"职场暗语","aliases":["向社会输送人才"],"kind":"word","source":"core"},{"term":"降本增效","meaning":"削减成本提高效率，实际语境里常指裁员缩编","register":"pro","field":"职场暗语","kind":"word","source":"core"},{"term":"通晒","meaning":"把信息在全员或跨部门范围内公开对齐","register":"pro","field":"互联网黑话","kind":"word","source":"core"},{"term":"护城河","meaning":"难以被对手复制的核心竞争力","register":"pro","field":"互联网黑话","aliases":["壁垒"],"kind":"word","source":"core"},{"term":"米","meaning":"规避写法：钱。「多少米」＝多少钱，直播/电商语境常见","register":"net","field":"规避写法","aliases":["多少米","现米"],"kind":"word","source":"core"},{"term":"广子","full":"广告","meaning":"「广告」的口语化规避写法","register":"net","field":"规避写法","aliases":["恰饭"],"kind":"word","source":"core"},{"term":"浮力","full":"福利","meaning":"「福利」的谐音规避写法，多指赠品、优惠、抽奖","register":"net","field":"规避写法","kind":"word","source":"core"},{"term":"私我","full":"私信我","meaning":"私信联系我，规避平台的导流检测","register":"net","field":"规避写法","aliases":["私信我"],"kind":"word","source":"core"},{"term":"上车","meaning":"下单/加入（拼团、课程、群），也指开始搞黄色","register":"net","field":"规避写法","kind":"word","source":"core"},{"term":"和谐","meaning":"被删除、被屏蔽（内容「被和谐了」）","register":"net","field":"规避写法","aliases":["被和谐"],"kind":"word","source":"core"},{"term":"喝茶","meaning":"被有关部门约谈、被叫去问话","register":"net","field":"规避写法","aliases":["被请喝茶"],"kind":"word","source":"core"},{"term":"开盒","meaning":"人肉搜索、扒出真实身份信息","register":"net","field":"网络暴力","aliases":["开盒挂人"],"kind":"word","source":"core"},{"term":"挂人","meaning":"公开点名曝光某人言行","register":"net","field":"网络暴力","aliases":["挂"],"kind":"word","source":"core"},{"term":"引流","meaning":"把人导流到自己的账号/私域","register":"net","field":"运营","kind":"word","source":"core"},{"term":"擦边","meaning":"打色情擦边球，游走在平台规则边缘的软色情内容","register":"net","field":"成人向","aliases":["擦边球"],"kind":"word","source":"core"},{"term":"涩涩","full":"色色","meaning":"「色色」的谐音规避写法，指色情内容或性暗示","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"搞黄色","meaning":"传播或讨论色情内容","register":"net","field":"成人向","aliases":["ghs","GHS"],"kind":"word","source":"core"},{"term":"开车","meaning":"讲荤段子、发色情内容；也指写性描写","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"老司机","meaning":"荤段子/资源经验丰富的人（引申为某领域老手）","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"车速太快","meaning":"调侃对方荤段子/色情内容来得太猛","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"车","meaning":"成人语境里的性描写段落（「这章有车」＝有性场面）","register":"net","field":"成人向","aliases":["有车","肉"],"kind":"word","source":"core"},{"term":"拉灯","meaning":"性场面一笔带过、直接跳到事后（「拉灯了」）","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"上垒","meaning":"棒球隐喻：亲密关系推进到某个阶段（一垒接吻、三垒…）","register":"net","field":"成人向","aliases":["本垒打","全垒打"],"kind":"word","source":"core"},{"term":"走肾","meaning":"只有肉体关系、不动感情（对应「走心」）","register":"net","field":"成人向","aliases":["走心"],"kind":"word","source":"core"},{"term":"船戏","full":"床戏","meaning":"「床戏」的谐音规避写法","register":"net","field":"成人向","kind":"word","source":"core"},{"term":"炮友","meaning":"只有性关系的对象","register":"vulg","field":"成人向","aliases":["约炮"],"kind":"word","source":"core"},{"term":"lol","meaning":"laugh out loud，笑出声","register":"net","field":"英文缩写","kind":"abbr","initials":"lol","source":"core"},{"term":"lmao","meaning":"laughing my ass off，笑死我了（比 lol 更夸张）","register":"net","field":"英文缩写","kind":"abbr","initials":"lmao","source":"core"},{"term":"omg","meaning":"oh my god，我的天","register":"net","field":"英文缩写","kind":"abbr","initials":"omg","source":"core"},{"term":"wtf","meaning":"what the fuck，什么鬼（惊讶/愤怒）","register":"vulg","field":"英文缩写","kind":"abbr","initials":"wtf","source":"core"},{"term":"gg","meaning":"good game，打得好；也用作「完了」","register":"net","field":"英文缩写","kind":"abbr","initials":"gg","source":"core"},{"term":"idk","meaning":"I do not know，我不知道","register":"net","field":"英文缩写","kind":"abbr","initials":"idk","source":"core"},{"term":"smh","meaning":"shaking my head，摇头（无语/不赞同）","register":"net","field":"英文缩写","kind":"abbr","initials":"smh","source":"core"},{"term":"nvm","meaning":"never mind，算了/当我没说","register":"net","field":"英文缩写","kind":"abbr","initials":"nvm","source":"core"},{"term":"886","meaning":"拜拜喽（谐音），再见","register":"net","field":"数字梗","kind":"word","source":"core"},{"term":"9494","meaning":"就是就是（谐音），表示赞同","register":"net","field":"数字梗","kind":"word","source":"core"},{"term":"520","meaning":"我爱你（谐音），也指 5 月 20 日","register":"net","field":"数字梗","kind":"word","source":"core"},{"term":"1314","meaning":"一生一世（谐音）","register":"net","field":"数字梗","kind":"word","source":"core"},{"term":"555","meaning":"呜呜呜（谐音），哭泣","register":"net","field":"数字梗","kind":"word","source":"core"},{"term":"钝角","meaning":"无厘头万能答案，源自选择题梗，表示懒得正经回答","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"电子榨菜","meaning":"吃饭时配着看的视频/剧，下饭用","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"嘴替","meaning":"替大家把心里话说出来的人","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"小丑竟是我自己","meaning":"自嘲：原来被耍、丢人的是我","register":"net","field":"网络流行语","aliases":["小丑是我"],"kind":"word","source":"core"},{"term":"格局小了","meaning":"眼界/胸怀不够，看问题太窄","register":"net","field":"网络流行语","aliases":["格局打开"],"kind":"word","source":"core"},{"term":"我直呼内行","meaning":"夸对方做法专业，也用于反讽","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"你礼貌吗","meaning":"质问对方说话做事是否失礼","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"我不理解","meaning":"表示无法理解、觉得荒谬","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"建议改成","meaning":"讽刺式建议体：「建议改成…」用来挖苦原文案","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"关我屁事","meaning":"与我无关（粗鲁），对应的还有「关你屁事」","register":"vulg","field":"网络口语","aliases":["关你屁事"],"kind":"word","source":"core"},{"term":"这波","meaning":"这次操作/这一轮（「这波稳了」「这波啊」）","register":"net","field":"网络口语","kind":"word","source":"core"}]
