[{"term":"栓Q","full":"thank you","meaning":"英文 thank you 的谐音，用来表达无语、无奈或带嘲讽的感谢","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"绷不住了","meaning":"情绪顶不住，忍不住笑或哭","register":"net","field":"网络流行语","aliases":["绷不住"],"kind":"word","source":"core"},{"term":"蚌埠住了","full":"绷不住了","meaning":"「绷不住了」的谐音写法，同义：忍不住笑或哭","register":"net","field":"谐音梗","aliases":["蚌埠住","蚌住"],"kind":"word","source":"core"},{"term":"耗子尾汁","full":"好自为之","meaning":"「好自为之」的方言谐音，出自马保国，嘲讽对方自重","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"雨女无瓜","full":"与你无关","meaning":"「与你无关」的口音谐音，出自《巴啦啦小魔仙》，用来怼人多管闲事","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"泰裤辣","full":"太酷啦","meaning":"「太酷啦」的谐音，夸人或调侃地表示很酷","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"瑞思拜","full":"respect","meaning":"英文 respect 的音译，表示致敬、服了","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"狗带","full":"go die","meaning":"英文 go die 的音译，去死（多用于自嘲式崩溃）","register":"net","field":"谐音梗","kind":"word","source":"core"},{"term":"绝绝子","meaning":"「太绝了」的卖萌说法，夸到极致，也常被用来反讽滥用夸赞","register":"net","field":"网络流行语","aliases":["绝绝"],"kind":"word","source":"core"},{"term":"无语子","meaning":"「无语」加语气词的软萌说法，表达无话可说","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"麻了","meaning":"麻木了，被离谱事弄到无感、无语","register":"net","field":"网络流行语","aliases":["人麻了"],"kind":"word","source":"core"},{"term":"乐","meaning":"抽象话：觉得好笑、看热闹不嫌事大，常单字使用","register":"net","field":"抽象话","aliases":["乐子"],"kind":"word","source":"core"},{"term":"典","meaning":"抽象话：太经典了、典型得可笑，讽刺对方发言套路化","register":"net","field":"抽象话","aliases":["典中典"],"kind":"word","source":"core"},{"term":"急了","meaning":"抽象话：嘲讽对方被激怒、破防了","register":"net","field":"抽象话","aliases":["急"],"kind":"word","source":"core"},{"term":"孝","meaning":"抽象话：反讽「孝子」，指盲目护主、无脑拥护","register":"net","field":"抽象话","aliases":["孝子"],"kind":"word","source":"core"},{"term":"赢","meaning":"抽象话：赢麻了，指靠自我安慰式的「精神胜利」","register":"net","field":"抽象话","aliases":["赢麻了"],"kind":"word","source":"core"},{"term":"润","full":"run","meaning":"英文 run 的谐音，跑路、离开、移民或退出不干了","register":"net","field":"抽象话","aliases":["润了"],"kind":"word","source":"core"},{"term":"寄","full":"GG","meaning":"「GG」的谐音，完了、没救了、game over","register":"net","field":"抽象话","aliases":["寄了"],"kind":"word","source":"core"},{"term":"逆天","meaning":"离谱到超出常理，可用于惊叹也可用于讽刺","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"抽象","meaning":"荒诞、难以理解、行为离谱，源自抽象工作室一脉的亚文化","register":"net","field":"抽象话","aliases":["太抽象了"],"kind":"word","source":"core"},{"term":"好家伙","meaning":"感叹词，表示惊讶、难以置信","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"666","full":"溜溜溜","meaning":"厉害、牛，谐音「溜溜溜」，也可反讽","register":"net","field":"网络口语","aliases":["6666"],"kind":"word","source":"core"},{"term":"233","meaning":"大笑，源自猫扑论坛表情编号 233，现表示笑出声","register":"net","field":"网络口语","aliases":["2333"],"kind":"word","source":"core"},{"term":"我裂开了","meaning":"我崩溃了、人裂了，比「麻了」更强烈的崩溃","register":"net","field":"网络流行语","aliases":["裂开"],"kind":"word","source":"core"},{"term":"笑不活了","meaning":"笑到不行、笑死了的夸张说法","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"离大谱","meaning":"「离谱」的加强版，太不合常理了","register":"net","field":"网络口语","aliases":["离谱"],"kind":"word","source":"core"},{"term":"就这","meaning":"反问式嘲讽：水平只有这么点？","register":"net","field":"网络口语","aliases":["就这？"],"kind":"word","source":"core"},{"term":"卧槽","meaning":"惊讶或愤怒时的粗口感叹","register":"vulg","field":"网络口语","kind":"word","source":"core"},{"term":"我靠","meaning":"惊讶、不满时的弱化版粗口","register":"vulg","field":"网络口语","kind":"word","source":"core"},{"term":"淦","full":"干","meaning":"「干」的谐音替代写法，表示惊讶、不满或发泄","register":"vulg","field":"谐音梗","kind":"word","source":"core"},{"term":"草","meaning":"「操」的谐音替代写法，表示惊讶或不满，也作语气词","register":"vulg","field":"谐音梗","aliases":["草了"],"kind":"word","source":"core"},{"term":"牛逼","meaning":"非常厉害（粗口，熟人之间可用）","register":"vulg","field":"网络口语","aliases":["牛批","牛B","NB"],"kind":"word","source":"core"},{"term":"装逼","meaning":"炫耀、故作高深、表现出自己很懂","register":"vulg","field":"网络口语","aliases":["装B"],"kind":"word","source":"core"},{"term":"傻逼","meaning":"辱骂语，蠢货；出现在小说对白里多为情绪爆发","register":"vulg","field":"辱骂","aliases":["傻B"],"kind":"word","source":"core"},{"term":"屌丝","meaning":"自嘲式称呼，指出身普通、条件一般、婚恋市场处劣势的男性","register":"vulg","field":"网络口语","kind":"word","source":"core"},{"term":"王八蛋","meaning":"混蛋，骂人话","register":"vulg","field":"辱骂","kind":"word","source":"core"},{"term":"拉胯","meaning":"表现差、不给力、掉链子","register":"net","field":"网络口语","aliases":["拉垮"],"kind":"word","source":"core"},{"term":"掉链子","meaning":"关键时刻出岔子、掉水准","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"摸鱼","meaning":"上班或该干活时偷懒、做私事","register":"net","field":"职场","kind":"word","source":"core"},{"term":"内耗","meaning":"内部反复消耗精力，也指团队内部空转","register":"net","field":"职场","aliases":["精神内耗"],"kind":"word","source":"core"},{"term":"卷王","meaning":"极度内卷、以超额投入卷到别人的人","register":"net","field":"职场","kind":"word","source":"core"},{"term":"躺赢","meaning":"不费力就赢了，靠他人或运气获胜","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"开摆","meaning":"开始摆烂，放弃努力","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"佛系","meaning":"随缘、不争不抢、低欲望的处世态度","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"社死","full":"社会性死亡","meaning":"当着众人出丑到极点，极度尴尬","register":"net","field":"网络流行语","aliases":["社会性死亡"],"kind":"word","source":"core"},{"term":"真香","meaning":"先坚决拒绝、后来自己真香的打脸场面，出自王境泽","register":"net","field":"网络流行语","kind":"word","source":"core"},{"term":"打脸","meaning":"先前的说法被事实推翻，自相矛盾被抓包","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"上头","meaning":"一时冲动、沉迷，情绪过载（也指喝多了）","register":"net","field":"网络口语","kind":"word","source":"core"},{"term":"塌房","meaning":"偶像人设崩塌、被爆出丑闻","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"糊","meaning":"不红了、热度掉光了；也指事情搞砸","register":"net","field":"饭圈","aliases":["糊了"],"kind":"word","source":"core"},{"term":"顶流","meaning":"热度最高的一线艺人","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"控评","meaning":"粉丝有组织地刷好评、压负面评论","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"打榜","meaning":"粉丝为偶像刷榜单数据","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"应援","meaning":"粉丝出钱出力支持偶像（灯牌、包场、应援物）","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"站姐","meaning":"长期跟拍某位艺人的粉丝摄影师","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"营业","meaning":"艺人发布内容或出来工作；也调侃普通人打起精神社交","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"出圈","meaning":"火到原本圈层之外，被大众知道","register":"net","field":"网络流行语","aliases":["破圈"],"kind":"word","source":"core"},{"term":"路人盘","meaning":"非粉丝的普通观众基础","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"避雷","meaning":"提前警示别踩坑（劣质商品、塌房艺人、烂服务）","register":"net","field":"网络口语","aliases":["排雷"],"kind":"word","source":"core"},{"term":"拉踩","meaning":"捧一个踩一个，通过贬低他人抬高自家","register":"net","field":"饭圈","kind":"word","source":"core"},{"term":"撕逼","meaning":"公开互相攻击、骂战","register":"vulg","field":"网络口语","aliases":["撕"],"kind":"word","source":"core"},{"term":"吧唧","meaning":"二次元周边里的徽章（badge 音译）","register":"net","field":"二次元","aliases":["badge"],"kind":"word","source":"core"},{"term":"痛包","meaning":"挂满角色徽章挂件的展示包","register":"net","field":"二次元","kind":"word","source":"core"},{"term":"梦女","meaning":"把自己代入与角色恋爱的女性粉丝","register":"net","field":"二次元","kind":"word","source":"core"},{"term":"攻受","meaning":"BL 关系中的主动方与被动方","register":"net","field":"二次元","kind":"word","source":"core"},{"term":"拆CP","meaning":"反对官方或大众认定的配对，主张拆开","register":"net","field":"二次元","aliases":["拆cp"],"kind":"word","source":"core"},{"term":"语c","full":"语言cosplay","meaning":"用文字扮演角色对话的玩法（语言cosplay）","register":"net","field":"二次元","aliases":["语C"],"kind":"word","source":"core"},{"term":"谷美","meaning":"拍二次元周边好看照片的行为与风格","register":"net","field":"二次元","kind":"word","source":"core"},{"term":